# The project is developed on Linux and increasingly built on Windows too.
# Git for Windows ships core.autocrlf=true in its system config, which would
# rewrite every file on the first Windows commit. Declaring the endings here
# makes the repository authoritative instead of the machine that clones it.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.svg  text eol=lf
*.xml  text eol=lf

*.png binary
*.ico binary

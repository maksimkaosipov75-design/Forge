TELEGRAM_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_IDS=your_user_id_here
CLI_PATH=/path/to/qwen

# Helper agents. The main agent can hand narrow pieces of work to a cheaper
# model instead of doing them itself. Written as provider[:model]; the first
# colon separates them, so an Ollama tag survives (local:qwen2.5-coder:7b).
# A bare provider name uses that provider's configured default model.
DELEGATION_ENABLED=1
DELEGATE_SEARCH=local
DELEGATE_REVIEW=local
DELEGATE_IMPLEMENT=local

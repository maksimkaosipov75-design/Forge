  <summary>Multi-provider AI agent workspace</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <developer_name>Forge contributors</developer_name>
  <launchable type="desktop-id">io.github.forge.Desktop.desktop</launchable>
